# Anthropic API key — required for AI synthesis and the market comparables agent.
# Without it, PropertyIQ falls back to a rule-based report from the raw data.
ANTHROPIC_API_KEY=

# Models per workload — defaults shown. Override to scale up or down.
#   Sonnet 4.6 — best cost/quality balance (~$0.02-0.05 per report)
#   Haiku 4.5  — cheapest (~$0.005-0.015 per report) — fine for quick chat
#   Opus 4.7   — best quality (~$0.05-0.15 per report) — agentic deep work
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_COMPARABLES=claude-sonnet-4-6
ANTHROPIC_MODEL_CHAT=claude-haiku-4-5

# Companies House API key — free at developer.company-information.service.gov.uk
# Required for /api/company-check.
COMPANIES_HOUSE_KEY=

# EPC Register — free signup. Two auth methods supported during the migration:
#
# 1. NEW — "Get energy performance of buildings data service" (Bearer token).
#    This is the auth method the legacy site is migrating to. Set this:
EPC_BEARER_TOKEN=
#
# 2. LEGACY — epc.opendatacommunities.org (Basic auth, retires 30 May 2026).
#    Set both if you don't have a Bearer token yet:
EPC_EMAIL=
EPC_API_KEY=
#
# Optional — override the EPC API base URL (defaults to the documented
# production URL https://api.get-energy-performance-data.communities.gov.uk):
EPC_BASE_URL=
#
# Optional — override the EPC search endpoint path and postcode parameter
# name. Defaults are now correct per official MHCLG docs:
#   EPC_SEARCH_PATH=/api/domestic/search
#   EPC_POSTCODE_PARAM=postcode
EPC_SEARCH_PATH=
EPC_POSTCODE_PARAM=

# Land Registry Business Gateway — optional, for paid Title Register lookups (v1.1)
LAND_REGISTRY_KEY=

# Server configuration
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
