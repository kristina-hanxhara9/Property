# Anthropic API key — required for AI synthesis and the market comparables agent.
# Without it, PropertyIQ falls back to a rule-based report from the raw data.
ANTHROPIC_API_KEY=

# Companies House API key — free at developer.company-information.service.gov.uk
# Required for /api/company-check.
COMPANIES_HOUSE_KEY=

# EPC Register — free signup at https://epc.opendatacommunities.org/
# Both must be set together for EPC lookup to work.
EPC_EMAIL=
EPC_API_KEY=

# Land Registry Business Gateway — optional, for paid Title Register lookups (v1.1)
LAND_REGISTRY_KEY=

# Server configuration
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
