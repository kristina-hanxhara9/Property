# Anthropic API key — required for AI synthesis and the market comparables agent.
# Without it, PropertyIQ falls back to a rule-based report from the raw data.
ANTHROPIC_API_KEY=

# Models per workload — defaults are Haiku 4.5 for cost. Override to upgrade.
#   Haiku 4.5  — cheapest, the default (~$0.015-0.05 per report)
#   Sonnet 4.6 — richer prose (~$0.05-0.15 per report)
#   Opus 4.7   — best quality (~$0.10-0.30 per report)
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL_COMPARABLES=claude-haiku-4-5
ANTHROPIC_MODEL_CHAT=claude-haiku-4-5
# Memo defaults to MODEL — promote just the memo to Sonnet if you want
# richer prose only on the investment memorandum:
ANTHROPIC_MODEL_MEMO=

# Companies House API key — free at developer.company-information.service.gov.uk
# Required for /api/company-check. Make sure the application is "Live", not "Test".
COMPANIES_HOUSE_KEY=

# EPC Register — free signup. Two auth methods supported during the migration:
#
# 1. NEW — "Get energy performance of buildings data service" (Bearer token).
#    Preferred. Sign up at epbregisters.com:
EPC_BEARER_TOKEN=
#
# 2. LEGACY — epc.opendatacommunities.org (Basic auth, retires 30 May 2026).
#    Set both if you don't have a Bearer token yet. Sign up at:
#    https://epc.opendatacommunities.org/
EPC_EMAIL=
EPC_API_KEY=
#
# Optional — override EPC API base URL / search path / postcode param.
# Defaults work per current MHCLG docs.
EPC_BASE_URL=
EPC_SEARCH_PATH=
EPC_POSTCODE_PARAM=

# HM Land Registry Open Data API — free signup at
# https://use-land-property-data.service.gov.uk/. Unlocks automated CCOD/OCOD
# corporate property holdings lookup in the JV report.
LAND_REGISTRY_OPEN_DATA_KEY=

# HMRC API — optional, free OAuth2 credentials for the VAT lookup API.
# Register an application at: https://developer.service.hmrc.gov.uk
# Subscribe it to "Check a UK VAT number" API and use the production
# Application Credentials. Without these PropertyIQ falls back to format
# checking + EU VIES (XI numbers only) + the Claude AI VAT discovery agent.
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=

# Server configuration
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
