# Anthropic API key — required for AI synthesis and the market comparables agent.
# Without it, PropertyIQ falls back to a rule-based report from the raw data.
ANTHROPIC_API_KEY=

# Companies House API key — free at developer.company-information.service.gov.uk
# Required for /api/company-check.
COMPANIES_HOUSE_KEY=

# EPC Register — free signup. Two auth methods supported during the migration:
#
# 1. NEW — "Get energy performance of buildings data service" (Bearer token).
#    This is the auth method the legacy site is migrating to. Set this:
EPC_BEARER_TOKEN=
#
# 2. LEGACY — epc.opendatacommunities.org (Basic auth, retires 30 May 2026).
#    Set both if you don't have a Bearer token yet:
EPC_EMAIL=
EPC_API_KEY=
#
# Optional — override the EPC API base URL (e.g. once the new endpoint is live):
EPC_BASE_URL=

# Land Registry Business Gateway — optional, for paid Title Register lookups (v1.1)
LAND_REGISTRY_KEY=

# Server configuration
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
